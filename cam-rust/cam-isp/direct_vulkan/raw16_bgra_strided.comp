#version 450

// Opaque RAW16 camera bytes -> packed BGRA words with explicit row strides.
// The input fd is imported as a storage VkBuffer, so the shader addresses each
// u16 sample through the plane's byte stride instead of assuming a tight plane.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer InBuf {
    uint words[];
} in_buf;

layout(rgba8, set = 0, binding = 1) writeonly uniform image2D out_img;

layout(push_constant) uniform Params {
    uvec2 size;
    uint input_stride_bytes;
    uint mode;
} params;

uint sample_at(uint x, uint y) {
    uint byte_offset = y * params.input_stride_bytes + x * 2u;
    uint word = in_buf.words[byte_offset >> 2u];
    return (word >> ((byte_offset & 3u) * 8u)) & 0xffffu;
}

uint grey(uint value) {
    return (value * 255u + 511u) / 1023u;
}

vec4 pixel(uint value) {
    float g = float(grey(value)) / 255.0;
    return vec4(g, g, g, 1.0);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint pixels = params.size.x * params.size.y;
    if (index >= pixels) {
        return;
    }

    uint x = index % params.size.x;
    uint y = index / params.size.x;
    uint value = sample_at(x, y);
    if (params.mode == 1u) {
        value = 1023u - value;
    }
    imageStore(out_img, ivec2(int(x), int(y)), pixel(value));
}
