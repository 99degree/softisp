#version 450

// Fused ISP: Bayer RGGB (INT16) -> Demosaic + CCM + Clip -> FHD RGB (FP16)
// Replaces: Cast(INT16->FP32) + SpaceToDepth + Conv1x1 + Clip + Downscale
// Input:  [1, 1, 2160, 3840] INT16 (RGGB Bayer)
// Output: [1, 3, 1080, 1920] FP16 Planar (R, G, B)

// === Uniforms (binding 0) ===
layout(set = 0, binding = 0) uniform Uniforms {
    uint  input_width;      // 3840
    uint  input_height;     // 2160
    uint  output_width;     // 1920
    uint  output_height;    // 1080
    uint  sensor_max;       // 1023
    float ccm[9];           // 3x3 row-major
    float wb_gains[4];      // RGGB
    float blc_vals[4];      // RGGB
} uniforms;

// === Buffers ===
layout(set = 0, binding = 1) readonly buffer InputBuffer  { uint bayer[]; };   // INT16 stored as uint
layout(set = 0, binding = 2) writeonly buffer OutputR     { uint r_plane[]; }; // FP16 stored as uint
layout(set = 0, binding = 3) writeonly buffer OutputG     { uint g_plane[]; };
layout(set = 0, binding = 4) writeonly buffer OutputB     { uint b_plane[]; };

uint to_fp16(float x) { return packHalf2x16(vec2(x, 0.0)); }

float read_bayer(uint x, uint y) {
    return float(bayer[y * uniforms.input_width + x]);
}

void demosaic(uint ox, uint oy, out vec3 rgb) {
    uint ix = ox * 2;
    uint iy = oy * 2;

    // RGGB pattern:
    // R(0,0) G(1,0)
    // G(0,1) B(1,1)

    float R = read_bayer(ix,     iy);
    float G1 = read_bayer(ix + 1, iy);
    float G2 = read_bayer(ix,     iy + 1);
    float B = read_bayer(ix + 1, iy + 1);

    // BLC + WB in sensor domain
    R = (R - uniforms.blc_vals[0]) * uniforms.wb_gains[0];
    G1 = (G1 - uniforms.blc_vals[1]) * uniforms.wb_gains[1];
    G2 = (G2 - uniforms.blc_vals[2]) * uniforms.wb_gains[2];
    B = (B - uniforms.blc_vals[3]) * uniforms.wb_gains[3];

    float G = (G1 + G2) * 0.5;

    // Normalize + CCM
    float inv_sensor_max = 1.0 / float(uniforms.sensor_max);
    float r_norm = R * inv_sensor_max;
    float g_norm = G * inv_sensor_max;
    float b_norm = B * inv_sensor_max;

    rgb.r = uniforms.ccm[0] * r_norm + uniforms.ccm[1] * g_norm + uniforms.ccm[2] * b_norm;
    rgb.g = uniforms.ccm[3] * r_norm + uniforms.ccm[4] * g_norm + uniforms.ccm[5] * b_norm;
    rgb.b = uniforms.ccm[6] * r_norm + uniforms.ccm[7] * g_norm + uniforms.ccm[8] * b_norm;

    rgb = clamp(rgb, 0.0, 1.0);
}

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;

    if (ox >= uniforms.output_width || oy >= uniforms.output_height) return;

    vec3 rgb;
    demosaic(ox, oy, rgb);

    uint out_idx = oy * uniforms.output_width + ox;

    r_plane[out_idx] = to_fp16(rgb.r);
    g_plane[out_idx] = to_fp16(rgb.g);
    b_plane[out_idx] = to_fp16(rgb.b);
}