#version 450
// Shader 3: Fcs — Flat Field / Shading Correction
// Input:  F32[1, 3, H, W] RGB
// Output: F32[1, 3, H, W] RGB (corrected)
// Dispatch: W × H × 1 (one thread per pixel)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float gain;            // correction strength
    float center_th;       // center threshold
    float suppression;     // max correction factor
    float pad[3];
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint w = uint(uniforms.width);
    uint h = uint(uniforms.height);
    if (x >= w || y >= h) return;

    uint plane = w * h;
    uint idx = y * w + x;

    // Read RGB (CHW layout)
    float r = in_data[0*plane + idx];
    float g = in_data[1*plane + idx];
    float b = in_data[2*plane + idx];

    // Luma-based FCS correction
    float luma = r * 0.299 + g * 0.587 + b * 0.114;
    float dev = abs(luma - 0.5) * 2.0;
    float corr = 1.0 + uniforms.gain * dev * dev;
    corr = clamp(corr, 1.0 - uniforms.suppression, 1.0 + uniforms.suppression);

    out_data[0*plane + idx] = r * corr;
    out_data[1*plane + idx] = g * corr;
    out_data[2*plane + idx] = b * corr;
}
