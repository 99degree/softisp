#version 450
// Shader 2: DemosaicCCM — RGGB→RGB demosaic + CCM color correction
// Input:  F32[1, 4, H/2, W/2] RGGB separated channels
// Output: F32[1, 3, H, W] RGB (after bilinear G interpolation + CCM)
// Dispatch: H/2 × W/2 × 1 (processes one 2x2 block)

layout(local_size_x = 2, local_size_y = 2, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float input_width;     // W/2 (RGGB quadrants)
    float input_height;    // H/2
    float output_width;    // W (full output)
    float output_height;   // H (full output)
    float sensor_max;
    float ccm[9];         // 3x3 row-major
    float pad[4];
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

// Helper: read a pixel from a specific RGGB channel (CHW layout)
float read_ch(int ch, uint x, uint y) {
    uint idx = ch * uint(uint(uniforms.input_height)) * uint(uint(uniforms.input_width))
             + y * uint(uint(uniforms.input_width)) + x;
    return in_data[idx];
}

// Helper: write a pixel to RGB output (CHW layout, 3 channels)
void write_rgb(uint x, uint y, float r, float g, float b) {
    uint plane = uint(uint(uniforms.output_height)) * uint(uint(uniforms.output_width));
    out_data[0*plane + y*uint(uint(uniforms.output_width)) + x] = r;
    out_data[1*plane + y*uint(uint(uniforms.output_width)) + x] = g;
    out_data[2*plane + y*uint(uint(uniforms.output_width)) + x] = b;
}

void main() {
    uint ox = gl_GlobalInvocationID.x;  // block x
    uint oy = gl_GlobalInvocationID.y;  // block y
    uint iw = uint(uniforms.input_width);
    uint ih = uint(uniforms.input_height);
    uint ow = uint(uniforms.output_width);
    uint oh = uint(uniforms.output_height);
    if (ox >= iw || oy >= ih) return;

    // Read RGGB at this block position
    float r  = read_ch(0, ox, oy);
    float gr = read_ch(1, ox, oy);
    float gb = read_ch(2, ox, oy);
    float b  = read_ch(3, ox, oy);

    // Average G channels
    float g = (gr + gb) * 0.5;

    // Apply CCM: 3x3 matrix multiply
    float c0 = uniforms.ccm[0]*r + uniforms.ccm[1]*g + uniforms.ccm[2]*b;
    float c1 = uniforms.ccm[3]*r + uniforms.ccm[4]*g + uniforms.ccm[5]*b;
    float c2 = uniforms.ccm[6]*r + uniforms.ccm[7]*g + uniforms.ccm[8]*b;

    // Output to 4 positions in the full-res grid (one 2x2 output block)
    // Each output pixel position maps from the interpolated RGGB values.
    // For simplicity, each of the 4 output positions uses the same
    // demosaiced RGB values from this 2x2 block (simple nearest-neighbor upscale).
    uint px = 2u * ox;  // TL x in output
    uint py = 2u * oy;  // TL y in output

    // Write all 4 output pixels (simple nearest neighbor)
    write_rgb(px,     py,     c0, c1, c2);
    if (px+1 < ow) write_rgb(px+1, py,     c0, c1, c2);
    if (py+1 < oh) write_rgb(px,   py+1,   c0, c1, c2);
    if (px+1 < ow && py+1 < oh) write_rgb(px+1, py+1, c0, c1, c2);
}
