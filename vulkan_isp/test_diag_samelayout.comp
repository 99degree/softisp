#version 450
// Diag shader with exact same layout as unpack_blc but writes constant values
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Uniforms {
    float input_width;
    float input_height;
    float output_width;
    float output_height;
    float sensor_max;
    float blc_r, blc_gr, blc_gb, blc_b;
    float wb_r, wb_gr, wb_gb, wb_b;
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf { int in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    // Just write constants to verify execution
    uint ow = uint(uniforms.output_width);
    uint oh = uint(uniforms.output_height);
    uint iw = uint(uniforms.input_width);
    
    out_data[0] = 1.0;
    out_data[1] = 2.0;
    out_data[2] = 3.0;
    out_data[3] = 4.0;
}
