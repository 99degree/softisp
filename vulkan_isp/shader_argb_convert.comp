#version 450
// isp.argb_convert — [1,3,H,W] float → [1,4,H,W] float ARGB scaled to [0,255]
// Input:  3-channel float RGB [0,1] (planar NCHW)
// Output: 4-channel float [0,255] as [A, R, G, B] (planar NCHW)
// The Rust engine packs this into INT32 ARGB8888.
// Uniforms: [0]=W, [1]=H
layout(local_size_x = 16, local_size_y = 16) in;

layout(std140, set = 0, binding = 0) readonly uniform Param { uint W; uint H; };
layout(std140, set = 0, binding = 1) readonly buffer  InBuf  { float in_data[]; };
layout(std140, set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= W || y >= H) return;

    uint spatial = y * W + x;
    uint plane = H * W;

    float r = in_data[0 * plane + spatial];
    float g = in_data[1 * plane + spatial];
    float b = in_data[2 * plane + spatial];

    // Output: [A, R, G, B] as separate channels, scaled to [0,255]
    out_data[0 * plane + spatial] = 255.0;                    // A = 255
    out_data[1 * plane + spatial] = clamp(r * 255.0, 0.0, 255.0); // R
    out_data[2 * plane + spatial] = clamp(g * 255.0, 0.0, 255.0); // G
    out_data[3 * plane + spatial] = clamp(b * 255.0, 0.0, 255.0); // B
}
