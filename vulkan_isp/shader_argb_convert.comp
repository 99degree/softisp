#version 450
// isp.argb_convert — [1,3,H,W] float → [1,4,H,W] uint8 ARGB
// Input: 3-channel float RGB in [0,1] (planar NCHW)
// Output: 4-channel uint8 ARGB (planar NCHW, packed as bytes)
// Uniforms: [0]=W, [1]=H
layout(local_size_x = 16, local_size_y = 16) in;

layout(std140, set = 0, binding = 0) readonly uniform Param { uint W; uint H; };
layout(std140, set = 0, binding = 1) readonly buffer  InBuf  { float in_data[]; };
layout(std140, set = 0, binding = 2) writeonly buffer OutBuf { uint   out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= W || y >= H) return;

    uint idx = y * W + x;
    float r = in_data[0 * H * W + idx];  // R channel
    float g = in_data[1 * H * W + idx];  // G channel
    float b = in_data[2 * H * W + idx];  // B channel

    // Clamp to [0,1] and convert to [0,255]
    uint ur = clamp(uint(r * 255.0 + 0.5), 0u, 255u);
    uint ug = clamp(uint(g * 255.0 + 0.5), 0u, 255u);
    uint ub = clamp(uint(b * 255.0 + 0.5), 0u, 255u);
    uint ua = 255u;  // alpha = 255

    // Pack as ARGB: A<<24 | R<<16 | G<<8 | B
    out_data[idx] = (ua << 24u) | (ur << 16u) | (ug << 8u) | ub;
}
