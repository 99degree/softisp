#version 450
// ============================================================================
// Shader 5: Ldci (Local Dynamic Contrast Improvement)
// Replaces: LdciBlock (7 ops including While loops)
// Input:  [1, 3, H, W] RGB
// Output: [1, 3, H, W] RGB
// ============================================================================

#ifndef USE_FP16
#define USE_FP16 0
#endif

#if USE_FP16
#pragma optionNV(fp16)
#endif

layout(set = 0, binding = 0) uniform Uniforms {
    uint input_width;
    uint input_height;
    uint output_width;
    uint output_height;
    uint sensor_max;
    float ccm[9];
    float wb_gains[4];
    float blc_vals[4];
    float ldci_strength;  // contrast enhancement strength
    float ldci_boost;     // local boost factor
    float dummy2;
    float dummy3;
} uniforms;

#if USE_FP16
#define StoreType uvec2
#else
#define StoreType vec4
#endif

layout(set = 0, binding = 1) readonly buffer Input  { StoreType rgb_in[]; };
layout(set = 0, binding = 2) writeonly buffer Output { StoreType rgb_out[]; };

float load_val(StoreType data, int comp) {
#if USE_FP16
    if (comp == 0) return unpackHalf2x16(data.x).x;
    if (comp == 1) return unpackHalf2x16(data.y).x;
    return 0.0;
#else
    return data[comp];
#endif
}

float calc_luma(float r, float g, float b) {
    return r * 0.299 + g * 0.587 + b * 0.114;
}

StoreType to_store(float r, float g, float b) {
#if USE_FP16
    return StoreType(packHalf2x16(vec2(r, 0.0)), packHalf2x16(vec2(g, 0.0)));
#else
    return StoreType(r, g, b, 0.0);
#endif
}

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;

    if (ox >= uniforms.output_width || oy >= uniforms.output_height) return;

    uint idx = oy * uniforms.output_width + ox;

    // Read center pixel
    StoreType center_data = rgb_in[idx];
    float r = load_val(center_data, 0);
    float g = load_val(center_data, 1);
    float b = load_val(center_data, 2);
    float center_luma = calc_luma(r, g, b);

    // 3x3 local average (simple box filter)
    float avg_luma = 0.0;
    float avg_r = 0.0, avg_g = 0.0, avg_b = 0.0;
    int count = 0;

    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            uint sx = ox + uint(dx);
            uint sy = oy + uint(dy);
            if (sx < uniforms.output_width && sy < uniforms.output_height) {
                StoreType s = rgb_in[sy * uniforms.output_width + sx];
                float sr = load_val(s, 0);
                float sg = load_val(s, 1);
                avg_r += sr;
                avg_g += sg;
                avg_b += load_val(s, 2);
                avg_luma += calc_luma(sr, sg, avg_b);
                count++;
            }
        }
    }

    avg_r /= float(count);
    avg_g /= float(count);
    avg_b /= float(count);
    avg_luma /= float(count);

    // Local contrast = center - local average
    float local_contrast = center_luma - avg_luma;

    // Enhance based on local contrast
    float enhancement = uniforms.ldci_strength * local_contrast;
    enhancement = clamp(enhancement, -0.3, 0.3);

    // Apply enhancement scaled by local brightness
    float brightness_factor = 1.0 + uniforms.ldci_boost * (center_luma - 0.5);
    enhancement *= brightness_factor;

    r = clamp(r + enhancement, 0.0, 1.0);
    g = clamp(g + enhancement, 0.0, 1.0);
    b = clamp(b + enhancement, 0.0, 1.0);

    rgb_out[idx] = to_store(r, g, b);
}