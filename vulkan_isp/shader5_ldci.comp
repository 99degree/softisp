#version 450
// Shader 5: Ldci — Local Dynamic Contrast Improvement
// Input:  F32[1, 3, H, W] RGB
// Output: F32[1, 3, H, W] RGB (contrast enhanced)
// Dispatch: W × H × 1

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float strength;
    float radius;
    float pad[4];
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

float read_pixel(int ch, int x, int y) {
    uint plane = uint(uniforms.width) * uint(uniforms.height);
    return in_data[ch*plane + uint(y)*uint(uniforms.width) + uint(x)];
}

void write_pixel(int ch, int x, int y, float val) {
    uint plane = uint(uniforms.width) * uint(uniforms.height);
    out_data[ch*plane + uint(y)*uint(uniforms.width) + uint(x)] = val;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int w = int(uint(uniforms.width));
    int h = int(uint(uniforms.height));
    if (x >= w || y >= h) return;

    int r = int(uniforms.radius);

    for (int ch = 0; ch < 3; ch++) {
        float center = read_pixel(ch, x, y);

        // Simple box blur for local mean
        float sum = 0.0;
        int count = 0;
        for (int dy = -r; dy <= r; dy++) {
            for (int dx = -r; dx <= r; dx++) {
                int sx = x + dx;
                int sy = y + dy;
                if (sx >= 0 && sx < w && sy >= 0 && sy < h) {
                    sum += read_pixel(ch, sx, sy);
                    count++;
                }
            }
        }
        float local_mean = sum / float(count);

        // Contrast enhancement: amplify deviation from local mean
        float diff = center - local_mean;
        center += uniforms.strength * diff;

        write_pixel(ch, x, y, center);
    }
}
