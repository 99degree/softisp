#version 450
// Fully fused 6-in-1 ISP shader (optimized): unpack→demosaic→fcs→ee→ldci→display
// All stages in one dispatch. No shared memory, no intermediate buffers.
// Each thread computes a 5×5 FCS grid from Bayer, then derives 3×3 EE, then LDCI+display.
// Workgroup: 16×16 (matches standard pipeline dispatch).
//
// Performance: eliminates 3 pipeline barriers + 3 intermediate buffer roundtrips.
// Redundant FCS recomputation is minimized by caching in local variables.
//
// Binding layout:
//   0: uniforms (std430 SSBO) — 24 floats
//   1: bayer INT32 in (readonly)
//   2: rgb FLOAT out (writeonly, CHW planar)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float u_w;            // [0]  FHD output width
    float u_h;            // [1]  FHD output height
    float u_bw;           // [2]  4K input width
    float u_bh;           // [3]  4K input height
    float u_smax;         // [4]  sensor_max
    float u_blc_r;        // [5]
    float u_blc_gr;       // [6]
    float u_blc_gb;       // [7]
    float u_blc_b;        // [8]
    float u_wb_r;         // [9]
    float u_wb_gr;        // [10]
    float u_wb_gb;        // [11]
    float u_wb_b;         // [12]
    float u_ccm[9];       // [13..21] CCM 3×3 row-major
    float u_fcs_str;      // [22]
    float u_fcs_off;      // [23]
    float u_ee_str;       // [24]
    float u_ee_thr;       // [25]
    float u_ldci_str;     // [26]
    float u_ldci_rad;     // [27]
    float u_disp_gamma;   // [28]
    float u_disp_bright;  // [29]
    float u_pad[3];       // [30..32]
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBayer { float bayer[]; };
layout(set = 0, binding = 2) writeonly buffer OutRGB { float out_data[]; };

// ── Edge-clamped Bayer pixel read ──
float read_bayer(int bx, int by) {
    int bw = int(uint(uniforms.u_bw));
    int bh = int(uint(uniforms.u_bh));
    return bayer[clamp(by, 0, bh-1) * bw + clamp(bx, 0, bw-1)];
}

// ── Full RGB compute for one FHD pixel: unpack + demosaic + FCS ──
vec3 compute_fcs(int fx, int fy) {
    int W = int(uint(uniforms.u_w));
    int H = int(uint(uniforms.u_h));
    fx = clamp(fx, 0, W-1);
    fy = clamp(fy, 0, H-1);

    int bx = 2 * fx;
    int by = 2 * fy;

    float r  = read_bayer(bx,     by);
    float gr = read_bayer(bx + 1, by);
    float gb = read_bayer(bx,     by + 1);
    float b  = read_bayer(bx + 1, by + 1);

    float smax = uniforms.u_smax;
    float rf  = r  / smax;
    float grf = gr / smax;
    float gbf = gb / smax;
    float bf  = b  / smax;

    rf  = max(rf  - uniforms.u_blc_r,  0.0);
    grf = max(grf - uniforms.u_blc_gr, 0.0);
    gbf = max(gbf - uniforms.u_blc_gb, 0.0);
    bf  = max(bf  - uniforms.u_blc_b,  0.0);

    rf  *= uniforms.u_wb_r;
    grf *= uniforms.u_wb_gr;
    gbf *= uniforms.u_wb_gb;
    bf  *= uniforms.u_wb_b;

    float g = (grf + gbf) * 0.5;

    // CCM 3×3
    float c0 = uniforms.u_ccm[0]*rf + uniforms.u_ccm[1]*g  + uniforms.u_ccm[2]*bf;
    float c1 = uniforms.u_ccm[3]*rf + uniforms.u_ccm[4]*g  + uniforms.u_ccm[5]*bf;
    float c2 = uniforms.u_ccm[6]*rf + uniforms.u_ccm[7]*g  + uniforms.u_ccm[8]*bf;
    rf = c0; g = c1; bf = c2;

    rf  = clamp(rf  * uniforms.u_fcs_str + uniforms.u_fcs_off, 0.0, 1.0);
    g   = clamp(g   * uniforms.u_fcs_str + uniforms.u_fcs_off, 0.0, 1.0);
    bf  = clamp(bf  * uniforms.u_fcs_str + uniforms.u_fcs_off, 0.0, 1.0);

    return vec3(rf, g, bf);
}

// ── EE: Laplacian sharpening from 5×5 FCS grid ──
vec3 compute_ee(vec3 c, vec3 t, vec3 b, vec3 l, vec3 r) {
    vec3 lap = 4.0 * c - (t + b + l + r);
    vec3 ee_val;
    float str = uniforms.u_ee_str;
    float thr = uniforms.u_ee_thr;
    for (int ch = 0; ch < 3; ch++) {
        float v = c[ch];
        if (abs(lap[ch]) > thr) v += str * lap[ch];
        ee_val[ch] = v;
    }
    return ee_val;
}

// ── sRGB gamma ──
float srgb_gamma(float x) {
    if (x > 0.0031308) return 1.055 * pow(x, 1.0 / 2.4) - 0.055;
    return x * 12.92;
}

// ── Main entry point ──
void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int W = int(uint(uniforms.u_w));
    int H = int(uint(uniforms.u_h));
    if (x >= W || y >= H) return;

    // ── Step 1: Compute 5×5 FCS grid ──
    // fcs[dy+2][dx+2] = FCS at pixel (x+dx, y+dy)
    // This covers all positions needed for 3×3 EE + 1 LDCI
    vec3 fcs[5][5];
    for (int dy = -2; dy <= 2; dy++) {
        for (int dx = -2; dx <= 2; dx++) {
            fcs[dy+2][dx+2] = compute_fcs(x + dx, y + dy);
        }
    }

    // ── Step 2: Compute 3×3 EE grid from FCS ──
    // ee[i] = EE at relative position i, where:
    //   [0]TL [-1,-1]  [1]TC [-1,0]  [2]TR [-1,1]
    //   [3]ML [0,-1]   [4]MC [0,0]   [5]MR [0,1]
    //   [6]BL [1,-1]   [7]BC [1,0]   [8]BR [1,1]
    vec3 ee[9];
    // TL: pixel (x-1,y-1)
    ee[0] = compute_ee(fcs[1][1], fcs[0][1], fcs[2][1], fcs[1][0], fcs[1][2]);
    // TC: pixel (x,y-1)
    ee[1] = compute_ee(fcs[1][2], fcs[0][2], fcs[2][2], fcs[1][1], fcs[1][3]);
    // TR: pixel (x+1,y-1)
    ee[2] = compute_ee(fcs[1][3], fcs[0][3], fcs[2][3], fcs[1][2], fcs[1][4]);
    // ML: pixel (x-1,y)
    ee[3] = compute_ee(fcs[2][1], fcs[1][1], fcs[3][1], fcs[2][0], fcs[2][2]);
    // MC: pixel (x,y) — center
    ee[4] = compute_ee(fcs[2][2], fcs[1][2], fcs[3][2], fcs[2][1], fcs[2][3]);
    // MR: pixel (x+1,y)
    ee[5] = compute_ee(fcs[2][3], fcs[1][3], fcs[3][3], fcs[2][2], fcs[2][4]);
    // BL: pixel (x-1,y+1)
    ee[6] = compute_ee(fcs[3][1], fcs[2][1], fcs[4][1], fcs[3][0], fcs[3][2]);
    // BC: pixel (x,y+1)
    ee[7] = compute_ee(fcs[3][2], fcs[2][2], fcs[4][2], fcs[3][1], fcs[3][3]);
    // BR: pixel (x+1,y+1)
    ee[8] = compute_ee(fcs[3][3], fcs[2][3], fcs[4][3], fcs[3][2], fcs[3][4]);

    // ── Step 3: LDCI — 3×3 box blur on EE grid + contrast ──
    vec3 sum_ee = vec3(0.0);
    for (int i = 0; i < 9; i++) {
        sum_ee += ee[i];
    }
    vec3 local_mean = sum_ee / 9.0;
    vec3 ldci_out = ee[4] + uniforms.u_ldci_str * (ee[4] - local_mean);

    // ── Step 4: Display gamma ──
    float gam = uniforms.u_disp_gamma;
    float bright = uniforms.u_disp_bright;
    vec3 final_rgb;
    for (int ch = 0; ch < 3; ch++) {
        float v = ldci_out[ch];
        v += bright;
        v = clamp(v, 0.0, 1.0);

        if (gam > 1.9) {
            if (v > 0.0031308)
                v = 1.055 * pow(v, 1.0 / 2.4) - 0.055;
            else
                v = v * 12.92;
        } else {
            v = pow(max(v, 0.0), 1.0 / gam);
        }
        v = clamp(v, 0.0, 1.0);
        final_rgb[ch] = v;
    }

    // ── Write CHW planar ──
    uint plane = uint(W) * uint(H);
    uint oidx = uint(y) * uint(W) + uint(x);
    out_data[0u * plane + oidx] = final_rgb.r;
    out_data[1u * plane + oidx] = final_rgb.g;
    out_data[2u * plane + oidx] = final_rgb.b;
}
