#version 450
// Diagnostic shader - same bindings as unpack_blc but writes known constants
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Uniforms {
    uint input_width;
    uint input_height;
    uint output_width;
    uint output_height;
    uint sensor_max;
    float blc_r, blc_gr, blc_gb, blc_b;
    float wb_r, wb_gr, wb_gb, wb_b;
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf { int in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;
    uint ow = uniforms.output_width;
    uint oh = uniforms.output_height;
    if (ox >= ow || oy >= oh) return;

    // Write constants to verify shader execution
    uint plane = oh * ow;
    uint oidx = oy * ow + ox;
    out_data[0u*plane + oidx] = float(uniforms.input_width) * 100.0 + 1.0;
    out_data[1u*plane + oidx] = float(uniforms.output_width) * 10.0 + 2.0;
    out_data[2u*plane + oidx] = float(uniforms.sensor_max) + 3.0;
    out_data[3u*plane + oidx] = uniforms.wb_r + 4.0;
}
