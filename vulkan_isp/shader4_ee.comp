#version 450
// Shader 4: Ee — Edge Enhancement / Sharpening
// Input:  F32[1, 3, H, W] RGB
// Output: F32[1, 3, H, W] RGB (sharpened)
// Dispatch: W × H × 1

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float strength;
    float threshold;
    float pad[4];
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

float read_pixel(int ch, int x, int y) {
    uint plane = uint(uniforms.width) * uint(uniforms.height);
    return in_data[ch*plane + uint(y)*uint(uniforms.width) + uint(x)];
}

void write_pixel(int ch, int x, int y, float val) {
    uint plane = uint(uniforms.width) * uint(uniforms.height);
    out_data[ch*plane + uint(y)*uint(uniforms.width) + uint(x)] = val;
}

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int w = int(uint(uniforms.width));
    int h = int(uint(uniforms.height));
    if (x >= w || y >= h) return;

    // Simple unsharp mask: laplacian 3x3 kernel
    for (int ch = 0; ch < 3; ch++) {
        // Read 3x3 neighborhood
        float c = read_pixel(ch, x, y);
        float t  = (y > 0)    ? read_pixel(ch, x, y-1) : c;
        float b  = (y < h-1)  ? read_pixel(ch, x, y+1) : c;
        float l  = (x > 0)    ? read_pixel(ch, x-1, y) : c;
        float r  = (x < w-1)  ? read_pixel(ch, x+1, y) : c;

        // Laplacian: 4*c - (t+b+l+r)
        float laplacian = 4.0*c - (t+b+l+r);
        float edge = abs(laplacian);

        // Apply sharpening if above threshold
        if (edge > uniforms.threshold) {
            c += uniforms.strength * laplacian;
        }
        write_pixel(ch, x, y, c);
    }
}
