#version 450
// MHC Demosaic — Modified High-Resolution Contrast Edge-Directed Demosaicing
// Input:  INT16/INT32[1, 1, H, W] Bayer raw
// Output: F32[1, 3, H, W] RGB at full resolution
// Dispatch: ceil(W/16) × ceil(H/16) × 1
//
// Edge-directed interpolation using gradient-based direction detection.
// Green is interpolated along edges (not across). Red/blue use
// color-difference constancy for improved accuracy.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Uniforms {
    float input_width;
    float input_height;
    float sensor_max;
    float pad0;
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf { int in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

// Read Bayer sample at (x,y) with clamped border
int readBayer(int x, int y) {
    int w = int(uniforms.input_width);
    int h = int(uniforms.input_height);
    x = clamp(x, 0, w - 1);
    y = clamp(y, 0, h - 1);
    return in_data[y * w + x];
}

// Read as float (normalized)
float readNorm(int x, int y) {
    return float(readBayer(x, y)) / uniforms.sensor_max;
}

void main() {
    uint px = gl_GlobalInvocationID.x;
    uint py = gl_GlobalInvocationID.y;
    uint w = uint(uniforms.input_width);
    uint h = uint(uniforms.input_height);
    if (px >= w || py >= h) return;

    int ix = int(px);
    int iy = int(py);

    // Bayer position in 2×2 grid (RGGB assumed)
    int bx = ix & 1;
    int by = iy & 1;

    float r, g, b;

    if (bx == 0 && by == 0) {
        // ── Red pixel ──
        float rv = readNorm(ix, iy);

        // Compute gradients from green neighbors (5×5 window)
        int gm_t = readBayer(ix,     iy - 1);  // Gr above
        int gm_b = readBayer(ix,     iy + 1);  // Gr below
        int gm_l = readBayer(ix - 1, iy);      // Gb left
        int gm_r = readBayer(ix + 1, iy);      // Gb right

        // More green samples for gradient
        int gm2_tl = readBayer(ix - 1, iy - 2); // Gb top-left
        int gm2_tr = readBayer(ix + 1, iy - 2); // Gb top-right
        int gm2_bl = readBayer(ix - 1, iy + 2); // Gb bottom-left
        int gm2_br = readBayer(ix + 1, iy + 2); // Gb bottom-right

        // Horizontal gradient: |Gr(x-2,y) - Gr(x,y)| + |Gr(x,y) - Gr(x+2,y)|
        int gm_l2 = readBayer(ix - 2, iy);      // Gr two left
        int gm_r2 = readBayer(ix + 2, iy);      // Gr two right
        float grad_h = abs(float(gm_l2 - gm_t)) + abs(float(gm_t - gm_r2)) +
                       abs(float(gm_l - gm_r)) + abs(float(gm2_tl - gm2_tr)) +
                       abs(float(gm2_bl - gm2_br));

        // Vertical gradient: |Gb(x,y-2) - Gb(x,y)| + |Gb(x,y) - Gb(x,y+2)|
        int gm_t2 = readBayer(ix, iy - 2);      // Gb two above
        int gm_b2 = readBayer(ix, iy + 2);      // Gb two below
        float grad_v = abs(float(gm_t - gm_b)) +
                       abs(float(gm_t2 - gm_t)) + abs(float(gm_b - gm_b2)) +
                       abs(float(gm2_tl - gm2_bl)) +
                       abs(float(gm2_tr - gm2_br));

        // Edge-directed green interpolation
        float gr_val = float(gm_t) / uniforms.sensor_max;  // Gr above
        float gb_val = float(gm_b) / uniforms.sensor_max;  // Gr below
        float g_l_val = float(gm_l) / uniforms.sensor_max;  // Gb left
        float grr_val = float(gm_r) / uniforms.sensor_max; // Gb right

        if (grad_h < grad_v) {
            // Horizontal edge: interpolate Gr horizontally
            float gl2 = float(gm_l2) / uniforms.sensor_max;
            float gr2 = float(gm_r2) / uniforms.sensor_max;
            g = (g_l_val + grr_val) * 0.5;
            // R-G difference: use horizontal neighbors
            float rg_l = readNorm(ix - 1, iy) - g_l_val;
            float rg_r = readNorm(ix + 1, iy) - grr_val;
            r = rv;
            b = rv + (rg_l + rg_r) * 0.5;  // B = R + (R-G) diff
        } else {
            // Vertical edge: interpolate Gb vertically
            float gt2 = float(gm_t2) / uniforms.sensor_max;
            float gb2 = float(gm_b2) / uniforms.sensor_max;
            g = (gr_val + gb_val) * 0.5;
            // R-G difference: use vertical neighbors
            float rg_t = readNorm(ix, iy - 1) - gr_val;
            float rg_b = readNorm(ix, iy + 1) - gb_val;
            r = rv;
            b = rv + (rg_t + rg_b) * 0.5;  // B = R + (R-G) diff
        }
    } else if (bx == 1 && by == 0) {
        // ── Gr pixel (green on red row) ──
        float gv = readNorm(ix, iy);

        // Red: interpolate along edge direction
        float rl = readNorm(ix - 1, iy);
        float rr = readNorm(ix + 1, iy);
        float rt = readNorm(ix, iy - 1);
        float rb = readNorm(ix, iy + 1);

        // Compute gradients from green samples
        float grad_h = abs(readNorm(ix - 2, iy) - readNorm(ix, iy)) +
                       abs(readNorm(ix, iy) - readNorm(ix + 2, iy));
        float grad_v = abs(readNorm(ix, iy - 2) - readNorm(ix, iy)) +
                       abs(readNorm(ix, iy) - readNorm(ix, iy + 2));

        if (grad_h < grad_v) {
            // Horizontal: interpolate R horizontally
            r = (rl + rr) * 0.5;
            // B: average vertical
            b = (rt + rb) * 0.5;
        } else {
            // Vertical: interpolate B vertically, R horizontally
            r = (rt + rb) * 0.5;
            b = (rl + rr) * 0.5;
        }
        g = gv;
    } else if (bx == 0 && by == 1) {
        // ── Gb pixel (green on blue row) ──
        float gv = readNorm(ix, iy);

        float rt = readNorm(ix, iy - 1);
        float rb = readNorm(ix, iy + 1);
        float rl = readNorm(ix - 1, iy);
        float rr = readNorm(ix + 1, iy);

        float grad_h = abs(readNorm(ix - 2, iy) - readNorm(ix, iy)) +
                       abs(readNorm(ix, iy) - readNorm(ix + 2, iy));
        float grad_v = abs(readNorm(ix, iy - 2) - readNorm(ix, iy)) +
                       abs(readNorm(ix, iy) - readNorm(ix, iy + 2));

        if (grad_h < grad_v) {
            // Horizontal: R interpolated horizontally, B vertically
            r = (rr + rl) * 0.5;
            b = (rt + rb) * 0.5;
        } else {
            // Vertical: interpolate B vertically
            r = (rt + rb) * 0.5;
            b = (rr + rl) * 0.5;
        }
        g = gv;
    } else {
        // ── Blue pixel ──
        float bv = readNorm(ix, iy);

        // Green samples
        int gm_t = readBayer(ix,     iy - 1);  // Gb above
        int gm_b = readBayer(ix,     iy + 1);  // Gb below
        int gm_l = readBayer(ix - 1, iy);      // Gr left
        int gm_r = readBayer(ix + 1, iy);      // Gr right

        // Extended gradient computation
        int gm_l2 = readBayer(ix - 2, iy);      // Gr two left
        int gm_r2 = readBayer(ix + 2, iy);      // Gr two right
        int gm_t2 = readBayer(ix, iy - 2);      // Gb two above
        int gm_b2 = readBayer(ix, iy + 2);      // Gb two below
        int gm2_tl = readBayer(ix - 1, iy - 2); // Gr top-left
        int gm2_tr = readBayer(ix + 1, iy - 2); // Gr top-right
        int gm2_bl = readBayer(ix - 1, iy + 2); // Gr bottom-left
        int gm2_br = readBayer(ix + 1, iy + 2); // Gr bottom-right

        float grad_h = abs(float(gm_l2 - gm_l)) + abs(float(gm_l - gm_r)) + abs(float(gm_r - gm_r2)) +
                       abs(float(gm2_tl - gm2_tr)) + abs(float(gm2_bl - gm2_br));
        float grad_v = abs(float(gm_t2 - gm_t)) + abs(float(gm_t - gm_b)) + abs(float(gm_b - gm_b2)) +
                       abs(float(gm2_tl - gm2_bl)) + abs(float(gm2_tr - gm2_br));

        float g_l_val = float(gm_l) / uniforms.sensor_max;
        float gr_val = float(gm_r) / uniforms.sensor_max;
        float gt_val = float(gm_t) / uniforms.sensor_max;
        float gb_val = float(gm_b) / uniforms.sensor_max;

        if (grad_h < grad_v) {
            // Horizontal edge: green from horizontal Gr
            g = (g_l_val + gr_val) * 0.5;
            // Color difference constancy: R = B + (R-B) diff
            float rb_l = readNorm(ix - 1, iy) - g_l_val;  // R-Gr at left
            float rb_r = readNorm(ix + 1, iy) - gr_val;  // R-Gr at right
            r = bv + (rb_l + rb_r) * 0.5;
            b = bv;
        } else {
            // Vertical edge: green from vertical Gb
            g = (gt_val + gb_val) * 0.5;
            float rb_t = readNorm(ix, iy - 1) - gt_val;  // R-Gb above
            float rb_b = readNorm(ix, iy + 1) - gb_val;  // R-Gb below
            r = bv + (rb_t + rb_b) * 0.5;
            b = bv;
        }
    }

    // Write RGB planar output
    uint plane = w * h;
    uint idx = py * w + px;
    out_data[0u * plane + idx] = clamp(r, 0.0, 1.0);
    out_data[1u * plane + idx] = clamp(g, 0.0, 1.0);
    out_data[2u * plane + idx] = clamp(b, 0.0, 1.0);
}
