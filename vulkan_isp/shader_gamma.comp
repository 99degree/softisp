#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0) readonly buffer InputBuf { float data[]; } inp;
layout(set = 0, binding = 1) writeonly buffer OutputBuf { float data[]; } outp;
layout(set = 0, binding = 2) readonly buffer ParamBuf { float inv_gamma; } param;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= inp.data.length()) return;
    float v = inp.data[idx];
    v = clamp(v, 0.0, 1.0);
    v = v + 1e-6;          // epsilon to avoid log(0)
    v = log(v);             // log
    v = v * param.inv_gamma;// scale by 1/gamma
    v = exp(v);             // pow(x, 1/gamma)
    outp.data[idx] = v;
}
