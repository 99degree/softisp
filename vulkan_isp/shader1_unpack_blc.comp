#version 450
// ============================================================================
// Shader 1: SpaceToDepth + BLC + WB (FP32/FP16 selectable)
// Replaces: Cast(INT16->FP32) + Sub(BLC) + Mul(WB)
// Input:  [1, 1, 2160, 3840] INT16 Bayer RGGB
// Output: [1, 4, 1080, 1920] FP32/FP16 RGGB channels (separated)
// ============================================================================

// Precision selector: 0 = FP32, 1 = FP16
#ifndef USE_FP16
#define USE_FP16 0
#endif

#if USE_FP16
#pragma optionNV(fp16)
#endif

layout(set = 0, binding = 0) uniform Uniforms {
    uint input_width;
    uint input_height;
    uint output_width;
    uint output_height;
    uint sensor_max;
    float ccm[9];
    float wb_gains[4];
    float blc_vals[4];
    float dummy1;
    float dummy2;
    float dummy3;
} uniforms;

// Storage type based on precision
#if USE_FP16
#define StoreType uvec2  // FP16 stored as 2xuint16
#else
#define StoreType float
#endif

// Buffers: input (INT16), output r/g1/g2/b
layout(set = 0, binding = 1) readonly buffer InputBuffer { uint bayer[]; };
layout(set = 0, binding = 2) writeonly buffer OutputR    { StoreType r_out[]; };
layout(set = 0, binding = 3) writeonly buffer OutputG1   { StoreType g1_out[]; };
layout(set = 0, binding = 4) writeonly buffer OutputG2   { StoreType g2_out[]; };
layout(set = 0, binding = 5) writeonly buffer OutputB    { StoreType b_out[]; };

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;

    if (ox >= uniforms.output_width || oy >= uniforms.output_height) return;

    uint ix = ox * 2;
    uint iy = oy * 2;

    // Read RGGB Bayer pattern
    float r  = float(bayer[iy * uniforms.input_width + ix]);
    float g1 = float(bayer[iy * uniforms.input_width + ix + 1]);
    float g2 = float(bayer[(iy + 1) * uniforms.input_width + ix]);
    float b  = float(bayer[(iy + 1) * uniforms.input_width + ix + 1]);

    // BLC + WB per channel
    r  = (r  - uniforms.blc_vals[0]) * uniforms.wb_gains[0];
    g1 = (g1 - uniforms.blc_vals[1]) * uniforms.wb_gains[1];
    g2 = (g2 - uniforms.blc_vals[2]) * uniforms.wb_gains[2];
    b  = (b  - uniforms.blc_vals[3]) * uniforms.wb_gains[3];

    // Write separated channels
    uint out_idx = oy * uniforms.output_width + ox;

#if USE_FP16
    r_out[out_idx] = packHalf2x16(vec2(r, 0.0));
    g1_out[out_idx] = packHalf2x16(vec2(g1, 0.0));
    g2_out[out_idx] = packHalf2x16(vec2(g2, 0.0));
    b_out[out_idx] = packHalf2x16(vec2(b, 0.0));
#else
    r_out[out_idx] = r;
    g1_out[out_idx] = g1;
    g2_out[out_idx] = g2;
    b_out[out_idx] = b;
#endif
}