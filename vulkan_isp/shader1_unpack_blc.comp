#version 450
// Shader 1: UnpackBLC — SpaceToDepth + Cast(INT16/INT32→F32) + BLC + WB
// Input:  INT32[1, 1, H, W] Bayer raw  (MNN converts INT16 to INT32)
// Output: F32[1, 4, H/2, W/2] RGGB separated, normalized, BLC+WB applied
// Dispatch: H/2 × W/2 × 1
//
// Note: MNN's ONNX converter converts INT16 tensors to INT32, so each
// element is a full 32-bit integer. The shader reads each pixel directly.

layout(local_size_x = 2, local_size_y = 2, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Uniforms {
    float input_width;
    float input_height;
    float output_width;
    float output_height;
    float sensor_max;
    float blc_r, blc_gr, blc_gb, blc_b;
    float wb_r, wb_gr, wb_gb, wb_b;
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf { int in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;
    uint ow = uint(uniforms.output_width);
    uint oh = uint(uniforms.output_height);
    if (ox >= ow || oy >= oh) return;

    uint iw = uint(uniforms.input_width);

    // Read RGGB pixels from 2x2 Bayer block
    // MNN stored INT32 per pixel, row-major: in_data[y * iw + x]
    uint x_tl = 2u * ox;      // top-left x
    uint y_tl = 2u * oy;      // top-left y

    int r  = in_data[(y_tl)     * iw + x_tl];       // TL = R
    int gr = in_data[(y_tl)     * iw + x_tl + 1u];   // TR = Gr
    int gb = in_data[(y_tl + 1u) * iw + x_tl];       // BL = Gb
    int b  = in_data[(y_tl + 1u) * iw + x_tl + 1u]; // BR = B

    // Normalize to [0, 1]
    float div = uniforms.sensor_max;
    float rf  = float(r)  / div;
    float grf = float(gr) / div;
    float gbf = float(gb) / div;
    float bf  = float(b)  / div;

    // BLC: subtract black level, clamp to 0
    rf  = max(rf  - uniforms.blc_r,  0.0);
    grf = max(grf - uniforms.blc_gr, 0.0);
    gbf = max(gbf - uniforms.blc_gb, 0.0);
    bf  = max(bf  - uniforms.blc_b,  0.0);

    // WB: multiply by white balance gain
    rf  *= uniforms.wb_r;
    grf *= uniforms.wb_gr;
    gbf *= uniforms.wb_gb;
    bf  *= uniforms.wb_b;

    // Write CHW flat: [4, H/2, W/2]
    uint plane = oh * ow;
    uint oidx = oy * ow + ox;
    out_data[0u*plane + oidx] = rf;
    out_data[1u*plane + oidx] = grf;
    out_data[2u*plane + oidx] = gbf;
    out_data[3u*plane + oidx] = bf;
}
