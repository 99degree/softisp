#version 450
// Shader 6: Display - Brightness/Contrast/Saturation + Gamma
// Input:  F32[1, 3, H, W] RGB (CHW layout)
// Output: F32[1, 3, H, W] RGB (CHW layout)
// Dispatch: W × H × 1

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float brightness;    // -0.5 to 0.5
    float contrast;      // 0.5 to 2.0
    float saturation;    // 0.0 to 2.0
    float gamma;         // 1.0 = linear, 2.2 = sRGB
    float pad[2];
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

// sRGB gamma correction
float srgb_gamma(float x) {
    if (x > 0.0031308) return 1.055 * pow(x, 1.0/2.4) - 0.055;
    return x * 12.92;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint w = uint(uniforms.width);
    uint h = uint(uniforms.height);
    if (x >= w || y >= h) return;

    uint plane = w * h;
    uint idx = y * w + x;

    // Read RGB (CHW layout)
    float r = in_data[0*plane + idx];
    float g = in_data[1*plane + idx];
    float b = in_data[2*plane + idx];

    // Brightness
    r += uniforms.brightness;
    g += uniforms.brightness;
    b += uniforms.brightness;

    // Contrast
    r = (r - 0.5) * uniforms.contrast + 0.5;
    g = (g - 0.5) * uniforms.contrast + 0.5;
    b = (b - 0.5) * uniforms.contrast + 0.5;

    // Saturation
    float luma = r * 0.299 + g * 0.587 + b * 0.114;
    r = mix(luma, r, uniforms.saturation);
    g = mix(luma, g, uniforms.saturation);
    b = mix(luma, b, uniforms.saturation);

    // Clip
    r = clamp(r, 0.0, 1.0);
    g = clamp(g, 0.0, 1.0);
    b = clamp(b, 0.0, 1.0);

    // Gamma correction (assume sRGB for 2.2)
    if (uniforms.gamma > 1.9) {
        r = srgb_gamma(r);
        g = srgb_gamma(g);
        b = srgb_gamma(b);
    } else {
        float inv_gamma = 1.0 / uniforms.gamma;
        r = pow(max(r, 0.0), inv_gamma);
        g = pow(max(g, 0.0), inv_gamma);
        b = pow(max(b, 0.0), inv_gamma);
    }

    // Final clip
    r = clamp(r, 0.0, 1.0);
    g = clamp(g, 0.0, 1.0);
    b = clamp(b, 0.0, 1.0);

    // Write output (CHW)
    out_data[0*plane + idx] = r;
    out_data[1*plane + idx] = g;
    out_data[2*plane + idx] = b;
}