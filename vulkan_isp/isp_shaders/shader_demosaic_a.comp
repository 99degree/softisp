#version 450
// shader_demosaic_a — Gradient-based (Malvar-He-Cutler) demosaic: 4ch RGGB → 3ch RGB
//
// Binding 0: SSBO uniforms (float[2]) — [0]=W, [1]=H
// Binding 1: SSBO input RGGB CHW (float 4×W×H)
// Binding 2: SSBO output RGB CHW (float 3×W×H)
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Uniforms { float u[]; };
layout(std430, binding = 1) readonly buffer InputBuf  { float inbuf[]; };
layout(std430, binding = 2) writeonly buffer OutputBuf { float outbuf[]; };

float tap(int x, int y, uint plane) {
    uint W = uint(u[0]);
    uint H = uint(u[1]);
    x = clamp(x, 0, int(W) - 1);
    y = clamp(y, 0, int(H) - 1);
    return inbuf[y * W + x + plane * W * H];
}

void main() {
    uint W = uint(u[0]);
    uint H = uint(u[1]);
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (uint(x) >= W || uint(y) >= H) return;

    uint plane = W * H;
    uint idx = y * W + x;

    bool row_even = (y % 2 == 0);
    bool col_even = (x % 2 == 0);

    float r, g, b;

    if (row_even && col_even) {
        // Red pixel — MHC interpolation
        float center_r = tap(x, y, 0);
        float gx = abs(tap(x - 1, y, 1) - tap(x + 1, y, 1));
        float gy = abs(tap(x, y - 1, 3) - tap(x, y + 1, 3));
        float gn = 0.5 * (tap(x, y - 1, 3) + tap(x, y + 1, 3));
        float ge = 0.5 * (tap(x - 1, y, 1) + tap(x + 1, y, 1));
        g = (gx > gy) ? gn : ge;
        float b_avg = 0.25 * (tap(x - 1, y - 1, 2) + tap(x + 1, y - 1, 2) +
                               tap(x - 1, y + 1, 2) + tap(x + 1, y + 1, 2));
        b = b_avg + 0.5 * (2.0 * center_r - gn - ge);
        r = center_r;
    } else if (!row_even && !col_even) {
        // Blue pixel — symmetric to red
        float center_b = tap(x, y, 2);
        float gx = abs(tap(x - 1, y, 1) - tap(x + 1, y, 1));
        float gy = abs(tap(x, y - 1, 3) - tap(x, y + 1, 3));
        float gn = 0.5 * (tap(x, y - 1, 3) + tap(x, y + 1, 3));
        float ge = 0.5 * (tap(x - 1, y, 1) + tap(x + 1, y, 1));
        g = (gx > gy) ? gn : ge;
        r = 0.25 * (tap(x - 1, y - 1, 0) + tap(x + 1, y - 1, 0) +
                     tap(x - 1, y + 1, 0) + tap(x + 1, y + 1, 0));
        r += 0.5 * (2.0 * center_b - gn - ge);
        b = center_b;
    } else if (row_even && !col_even) {
        // Green on red row — interpolate R and B
        float center_g = tap(x, y, 1);
        float dr = 0.5 * (tap(x - 1, y, 0) + tap(x + 1, y, 0));
        float dc = 0.5 * (tap(x, y - 1, 2) + tap(x, y + 1, 2));
        float corr = 0.25 * (tap(x, y - 1, 1) + tap(x, y + 1, 1) +
                              tap(x - 1, y, 3) + tap(x + 1, y, 3) - 2.0 * center_g);
        r = dr + corr;
        g = center_g;
        b = dc + corr;
    } else {
        // Green on blue row
        float center_g = tap(x, y, 3);
        float dr = 0.5 * (tap(x, y - 1, 0) + tap(x, y + 1, 0));
        float dc = 0.5 * (tap(x - 1, y, 2) + tap(x + 1, y, 2));
        float corr = 0.25 * (tap(x, y - 1, 3) + tap(x, y + 1, 3) +
                              tap(x - 1, y, 1) + tap(x + 1, y, 1) - 2.0 * center_g);
        r = dr + corr;
        g = center_g;
        b = dc + corr;
    }

    outbuf[idx + 0u * plane] = clamp(r, 0.0, 1.0);
    outbuf[idx + 1u * plane] = clamp(g, 0.0, 1.0);
    outbuf[idx + 2u * plane] = clamp(b, 0.0, 1.0);
}
