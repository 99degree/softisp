#version 450
// shader_demosaic_edge — Edge-directed demosaic: 4ch RGGB → 3ch RGB
// Chooses horizontal vs vertical interpolation based on local gradient.
//
// Binding 0: SSBO uniforms (float[4]) — [0]=W, [1]=H, [2]=edge_threshold, [3]=pad0
// Binding 1: SSBO input RGGB CHW (float 4×W×H)
// Binding 2: SSBO output RGB CHW (float 3×W×H)
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer Uniforms { float u[]; };
layout(std430, binding = 1) readonly buffer InputBuf  { float inbuf[]; };
layout(std430, binding = 2) writeonly buffer OutputBuf { float outbuf[]; };

float tap(int x, int y, uint plane) {
    uint W = uint(u[0]);
    uint H = uint(u[1]);
    x = clamp(x, 0, int(W) - 1);
    y = clamp(y, 0, int(H) - 1);
    return inbuf[y * W + x + plane * W * H];
}

void main() {
    uint W = uint(u[0]);
    uint H = uint(u[1]);
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (uint(x) >= W || uint(y) >= H) return;

    uint plane = W * H;
    uint idx = y * W + x;

    bool row_even = (y % 2 == 0);
    bool col_even = (x % 2 == 0);

    bool use_vert = (abs(tap(x, y - 1, 1) - tap(x, y + 1, 1)) >
                     abs(tap(x - 1, y, 1) - tap(x + 1, y, 1)));

    float r, g, b;

    if (row_even && col_even) {
        // Red pixel
        r = tap(x, y, 0);
        if (use_vert) {
            g = 0.5 * (tap(x, y - 1, 3) + tap(x, y + 1, 3));
        } else {
            g = 0.5 * (tap(x - 1, y, 1) + tap(x + 1, y, 1));
        }
        b = 0.25 * (tap(x - 1, y - 1, 2) + tap(x + 1, y - 1, 2) +
                     tap(x - 1, y + 1, 2) + tap(x + 1, y + 1, 2));
    } else if (!row_even && !col_even) {
        // Blue pixel
        b = tap(x, y, 2);
        if (use_vert) {
            g = 0.5 * (tap(x, y - 1, 3) + tap(x, y + 1, 3));
        } else {
            g = 0.5 * (tap(x - 1, y, 1) + tap(x + 1, y, 1));
        }
        r = 0.25 * (tap(x - 1, y - 1, 0) + tap(x + 1, y - 1, 0) +
                     tap(x - 1, y + 1, 0) + tap(x + 1, y + 1, 0));
    } else if (row_even && !col_even) {
        // Green on red row
        g = tap(x, y, 1);
        r = 0.5 * (tap(x - 1, y, 0) + tap(x + 1, y, 0));
        b = 0.5 * (tap(x, y - 1, 2) + tap(x, y + 1, 2));
    } else {
        // Green on blue row
        g = tap(x, y, 3);
        r = 0.5 * (tap(x, y - 1, 0) + tap(x, y + 1, 0));
        b = 0.5 * (tap(x - 1, y, 2) + tap(x + 1, y, 2));
    }

    outbuf[idx + 0u * plane] = clamp(r, 0.0, 1.0);
    outbuf[idx + 1u * plane] = clamp(g, 0.0, 1.0);
    outbuf[idx + 2u * plane] = clamp(b, 0.0, 1.0);
}
