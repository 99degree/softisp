#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) readonly uniform image2D input_img;
layout(set = 0, binding = 1, rgba32f) writeonly uniform image2D output_img;

layout(set = 0, binding = 2) uniform Params {
    float sigma;
    int kernel_size;
} params;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(input_img);
    
    if (pos.x >= size.x || pos.y >= size.y) return;
    
    vec3 sum = vec3(0.0);
    float count = 0.0;
    int half_k = params.kernel_size / 2;
    
    // Box filter for local mean
    for (int dy = -half_k; dy <= half_k; dy++) {
        for (int dx = -half_k; dx <= half_k; dx++) {
            ivec2 p = clamp(pos + ivec2(dx, dy), ivec2(0), size - 1);
            sum += imageLoad(input_img, p).rgb;
            count += 1.0;
        }
    }
    
    vec3 mean = sum / count;
    vec3 color = imageLoad(input_img, pos).rgb;
    vec3 residual = color - mean;
    
    // Soft threshold
    vec3 thresholded = sign(residual) * max(abs(residual) - params.sigma, 0.0);
    
    imageStore(output_img, pos, vec4(mean + thresholded, 1.0));
}
