#version 450
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer Uniforms {
    float input_width;
    float input_height;
    float output_width;
    float output_height;
    float sensor_max;
    float blc_r, blc_gr, blc_gb, blc_b;
    float wb_r, wb_gr, wb_gb, wb_b;
} uniforms;

layout(set = 0, binding = 1) readonly buffer InBuf { int in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint ox = gl_GlobalInvocationID.x;
    uint oy = gl_GlobalInvocationID.y;
    uint ow = uint(uniforms.output_width);
    uint oh = uint(uniforms.output_height);
    if (ox >= ow || oy >= oh) return;
    
    uint iw = uint(uniforms.input_width);
    uint x_tl = 2u * ox;
    uint y_tl = 2u * oy;
    
    int r  = in_data[(y_tl)     * iw + x_tl];
    int gr = in_data[(y_tl)     * iw + x_tl + 1u];
    int gb = in_data[(y_tl + 1u) * iw + x_tl];
    int b  = in_data[(y_tl + 1u) * iw + x_tl + 1u];
    
    uint plane = oh * ow;
    uint oidx = oy * ow + ox;
    out_data[0u*plane + oidx] = float(r);
    out_data[1u*plane + oidx] = float(gr);
    out_data[2u*plane + oidx] = float(gb);
    out_data[3u*plane + oidx] = float(b);
}
