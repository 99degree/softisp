<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Full-screen camera preview (HW ISP, kept for MATCH captures) -->
    <!-- SurfaceView used instead of TextureView for lower latency (direct compositing) -->
    <SurfaceView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pipeline output overlay (top-right PIP) -->
    <ImageView
        android:id="@+id/full_preview"
        android:layout_width="180dp"
        android:layout_height="135dp"
        android:layout_gravity="top|right"
        android:layout_marginTop="48dp"
        android:layout_marginRight="8dp"
        android:scaleType="fitCenter"
        android:background="#80000000" />

    <!-- Controls Panel (Compose-based) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/controls_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

</FrameLayout>